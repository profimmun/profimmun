# ─────────────────────────── База данных (обязательно) ───────────────────────
# PostgreSQL. Подойдёт любой провайдер: Neon, Supabase, Vercel Postgres, свой сервер.
# Docker не нужен — можно использовать одну облачную базу и локально, и на Vercel.

# Пулированное подключение — его использует приложение.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# DIRECT_URL больше не нужна — достаточно DATABASE_URL

# ─────────────────────────── Безопасность (обязательно) ──────────────────────
# Длинная случайная строка. Сгенерировать:  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# ─────────────────────────── Администратор ───────────────────────────────────
# Из этих переменных при каждом деплое создаётся администратор.
# Значения задавайте только в окружении (локальный .env / Vercel Env Vars),
# в репозиторий их коммитить нельзя.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Администратор"

# ─────────────────────────── Адрес приложения ────────────────────────────────
# Для продакшена укажите свой домен, иначе ссылки в письмах сброса пароля
# будут вести на превью-деплой. Локально можно не задавать.
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ─────────────────────────── Загрузка файлов ─────────────────────────────────
# Обязательно на Vercel: там файловая система read-only, поэтому обложки и видео
# сохраняются в Blob-хранилище. Создаётся в панели Vercel → Storage → Blob.
# Если переменная не задана, файлы пишутся в public/uploads (только локально).
BLOB_READ_WRITE_TOKEN=""

# ─────────────────────────── Поддержка ───────────────────────────────────────
# Куда приходят обращения со страницы /support.
# Если не задано — берётся supportEmail из src/lib/legal.ts.
# Обращения в любом случае сохраняются в базе и видны в админке.
SUPPORT_EMAIL=""

# ─────────────────────────── Почта (необязательно) ───────────────────────────
# Нужен для отправки писем поддержки и сброса пароля.
# Без SMTP письма печатаются в лог сервера.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Платформа <no-reply@example.com>"
